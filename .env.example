# Digitalisierung — example configuration.
# Copy to `.env` (which is gitignored) and adjust. No secrets belong in git.

# --- General ---------------------------------------------------------------
DEBUG=false

# --- Network ---------------------------------------------------------------
# Bind to localhost only by default — these documents are PII. Do NOT set
# HOST=0.0.0.0 unless you have put authentication and a firewall in front.
HOST=127.0.0.1
PORT=8000
# Optional API key for mutating/expensive endpoints (corrections, training).
# Leave empty to disable (safe under the localhost-only default bind).
API_KEY=

# --- Models ----------------------------------------------------------------
VLM_MODEL_ID=surya-ocr
LLM_MODEL_PATH=backend/models/llama-3.1-8b-instruct.Q4_K_M.gguf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Apple Metal: -1 offloads all llama.cpp layers to the GPU.
LLM_N_GPU_LAYERS=-1
# Optional local-LLM structuring to fill OCR-missed fields (needs the GGUF model).
ENABLE_LLM_STRUCTURING=false
# Optionally pin the GGUF SHA-256 so setup verifies the download.
LLM_MODEL_SHA256=

# Surya device: leave blank to auto-detect (mps on Apple Silicon, else cpu).
SURYA_DEVICE=

# --- Determinism -----------------------------------------------------------
VLM_TEMPERATURE=0.0
LLM_TEMPERATURE=0.0

# --- Storage ---------------------------------------------------------------
CHROMA_PERSIST_DIR=./backend/chroma_data
AUDIT_LOG_PATH=./backend/logs/audit.jsonl
UPLOAD_DIR=./backend/uploads
